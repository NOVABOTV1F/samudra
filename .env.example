# Site settings → Environment variables / Runtime secrets
#
# Chat AI:
#   GEMINI_API_KEY = (V1)
#   GROQ_API_KEY   = (V2)
#
# Deploy Premium (V1 GitHub / V2 Vercel / V3 Cloudflare):
#   GITHUB_TOKEN          = personal access token (repo + pages)
#   GITHUB_OWNER          = username/org GitHub kamu
#   VERCEL_TOKEN          = opsional untuk V2
#   CLOUDFLARE_API_TOKEN  = opsional untuk V3
#   CLOUDFLARE_ACCOUNT_ID = opsional untuk V3
#   DEPLOY_PREMIUM_KEYS   = key1,key2  (opsional; format ZUZUKX😶_103942974V1.5-xxxx)
#
# User tidak isi API key di frontend.

GEMINI_API_KEY=
GROQ_API_KEY=
GITHUB_TOKEN=
GITHUB_OWNER=
VERCEL_TOKEN=
