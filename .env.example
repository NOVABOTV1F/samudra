# ============================================
# ZUZUXF_AI — API Keys (Netlify / lokal)
# ============================================
# JANGAN commit file .env berisi key asli ke GitHub.
#
# Cara di Netlify:
# 1. Site settings → Environment variables
# 2. Add variable:
#    GEMINI_API_KEY  = (key Gemini kamu)
#    GROQ_API_KEY    = (key Groq kamu)
#    XAI_API_KEY     = (opsional, kalau masih pakai Grok)
# 3. Save → Trigger deploy ulang
#
# Atau isi lewat Settings di dalam app (tersimpan di browser).
#
# V1 di app = Gemini  → butuh GEMINI_API_KEY
# V2 di app = Groq    → butuh GROQ_API_KEY

GEMINI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=

# Opsional model default
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_MODEL=llama-3.3-70b-versatile
