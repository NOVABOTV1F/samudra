# ============================================
# Samudra v1.5 — Cloudflare Workers secrets
# ============================================
# Hosting app: Cloudflare Workers
# Tempat isi token: Cloudflare Dashboard
#   Workers & Pages → (worker Samudra) → Settings
#   → Variables and Secrets → Add
#
# --- Chat AI ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Deploy Premium V1 = GitHub Pages ---
# Buat token: GitHub → Settings → Developer settings → Personal access tokens
# Scope: repo, (opsional) pages
GITHUB_TOKEN=
GITHUB_OWNER=NOVABOTV1F

# --- Deploy Premium V2 = Vercel (opsional) ---
# Buat token: vercel.com → Settings → Tokens
VERCEL_TOKEN=

# --- Deploy Premium V3 = Cloudflare Pages (opsional) ---
# Buat token: dash.cloudflare.com → My Profile → API Tokens
# Account ID: di sidebar kanan overview account
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Opsional: batasi key premium (pisah koma) ---
# Kalau kosong, server terima format ZUZUKX_ + 6–24 huruf/angka
DEPLOY_PREMIUM_KEYS=
