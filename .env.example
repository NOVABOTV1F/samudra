# ============================================
# ZUZUXF_AI — API Keys (untuk Netlify / server)
# ============================================
# JANGAN commit file .env berisi key asli ke GitHub.
#
# Cara di Netlify:
# 1. Site settings → Environment variables
# 2. Tambah:
#    GEMINI_API_KEY = (key Gemini kamu)
#    GROQ_API_KEY   = (key Groq kamu)
# 3. Save → Trigger redeploy
#
# Di app:
#   V1 = Gemini  → pakai GEMINI_API_KEY
#   V2 = Groq    → pakai GROQ_API_KEY
# User tidak perlu isi key — langsung chat.

GEMINI_API_KEY=
GROQ_API_KEY=

# Opsional (kalau masih pakai xAI di host Grok)
# XAI_API_KEY=
