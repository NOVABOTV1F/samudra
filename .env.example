# ============================================
# ZUZUXF_AI — API Keys & Config
# ============================================
# Copy this file to .env (jangan commit .env ke GitHub!)
# Atau isi di Vercel / Netlify → Environment Variables

# xAI / Grok (default host)
XAI_API_KEY=

# Google Gemini
# Ambil di: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq
# Ambil di: https://console.groq.com/keys
GROQ_API_KEY=

# Opsional — default model per provider
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# XAI_MODEL=grok-4.5
