# ============================================
# Samudra — Cloudflare Workers secrets
# ============================================
# Tempat isi: Workers & Pages → worker Samudra → Settings
#   → Variables and Secrets → Add (Encrypt untuk key)
#
# --- Chat AI (utama: DeepSeek via FreeModel) ---
# Token dari https://freemodel.in  (awalannya fm_…)
FREEMODEL_API_KEY=
# Opsional alias:
# DEEPSEEK_API_KEY=
# FM_API_KEY=
#
# Base URL (default sudah benar, jarang perlu diubah)
# FREEMODEL_BASE_URL=https://freemodel.in/v1
#
# Model (default: deepseek-v4-pro-0813 = DeepSeek V4 Pro)
# DEEPSEEK_MODEL=deepseek-v4-pro-0813
# Alternatif lebih cepat/murah: deepseek-v4-flash-0731
#
# --- Cadangan (opsional) ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Deploy Premium ---
GITHUB_TOKEN=
GITHUB_OWNER=NOVABOTV1F
VERCEL_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
DEPLOY_PREMIUM_KEYS=
